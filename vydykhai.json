{
  "schemaVersion": 1,
  "name": "vydykhai",
  "version": "1.26.0",
  "creator": {
    "name": "Alexander Rozhnov",
    "nameRu": "Александр Рожнов",
    "github": "vonjor-lab"
  },
  "copyright": "Copyright (c) 2026 Alexander Rozhnov",
  "license": "PolyForm-Small-Business-1.0.0",
  "canonicalSource": "https://github.com/vonjor-lab/vydykhai-humans-as-agents",
  "requiredNotice": "Required Notice: Vydykhai was created and originally published by Alexander Rozhnov (vonjor-lab). Canonical source: https://github.com/vonjor-lab/vydykhai-humans-as-agents. Copyright (c) 2026 Alexander Rozhnov.",
  "commercialLicensing": "https://github.com/vonjor-lab/vydykhai-humans-as-agents/blob/main/COMMERCIAL-LICENSING.md",
  "provenance": "https://github.com/vonjor-lab/vydykhai-humans-as-agents/blob/main/docs/PROVENANCE.md",
  "upstream": "https://github.com/vonjor-lab/vydykhai-humans-as-agents.git",
  "upstreamManifest": "https://raw.githubusercontent.com/vonjor-lab/vydykhai-humans-as-agents/main/vydykhai.json",
  "bootstrap": "https://raw.githubusercontent.com/vonjor-lab/vydykhai-humans-as-agents/main/BOOTSTRAP.md",
  "defaultAgentProfile": {
    "modelPolicy": "latest-available-flagship",
    "reasoningPolicy": "deepest-bounded",
    "reasoningEffort": "xhigh",
    "refreshDays": 7
  },
  "agentRoutingPolicy": {
    "policy": "role-routed",
    "modelPolicy": "latest-available-flagship",
    "refreshDays": 7,
    "profiles": {
      "orchestrator": {
        "reasoningPolicy": "maximum-available",
        "preferredEffortWhenAvailable": "ultra"
      },
      "discovery": {
        "reasoningPolicy": "deep-bounded",
        "preferredEffortWhenAvailable": "xhigh"
      },
      "execution": {
        "reasoningPolicy": "efficient-bounded",
        "preferredEffortWhenAvailable": "low"
      }
    }
  },
  "orchestratorAdvisoryPolicy": {
    "policy": "control-only-advisory",
    "requiredPromptFields": [
      "control-decision",
      "available-sources",
      "expected-orchestration-output",
      "route-to-focused-context-when"
    ],
    "results": [
      "control-only",
      "route-to-focused-context"
    ],
    "acceptedProjectEvidenceSources": [
      "human-decision",
      "durable-source",
      "focused-context-receipt"
    ],
    "guardSignal": "unowned-project-work"
  },
  "projectActivationPolicy": {
    "policy": "evidence-backed-project-activation",
    "requiredChecks": [
      "target-repository-and-framework",
      "shared-repo-and-tracker",
      "participant-readiness",
      "coordination-input-route",
      "current-operational-route",
      "compass-and-first-dod",
      "orchestrator-and-return-sync",
      "first-route-and-next-best-action"
    ],
    "results": [
      "project-ready",
      "project-ready-with-limits",
      "needs-decision",
      "blocked-by-access"
    ]
  },
  "controlLoopPolicy": {
    "policy": "governor-audited-event-loop",
    "projectStateVersion": 2,
    "states": [
      "healthy",
      "repair",
      "rotate"
    ],
    "requiredChecks": [
      "current-dod-line",
      "execution-leases",
      "pending-return-inbox",
      "detour-return-gates",
      "memory-coverage",
      "actual-orchestrator-context",
      "work-origin",
      "orchestrator-health",
      "human-attention-continuity"
    ],
    "triggers": [
      "project-activation",
      "task-dispatch-or-resume",
      "return-sync",
      "human-correction-or-detour",
      "milestone-or-framework-update",
      "context-compaction-or-loss",
      "active-24-hours"
    ]
  },
  "controlStatePublicationPolicy": {
    "policy": "validate-publish-readback-or-restore",
    "stages": [
      "render-candidate",
      "validate-candidate",
      "publish-once",
      "readback-exact",
      "restore-last-accepted-on-mismatch"
    ],
    "requiredEvidence": [
      "accepted-state-reference",
      "candidate-state-sha256",
      "candidate-validation",
      "readback-state-sha256",
      "readback-validation"
    ],
    "failedWriteState": "never-current"
  },
  "projectGuardPolicy": {
    "policy": "external-event-and-schedule",
    "defaultIntervalMinutes": 30,
    "healthyPath": "deterministic-no-model",
    "anomalyProfile": "maximum-available",
    "incidentIdentity": "semantic-condition-set",
    "snapshotHashRole": "evidence-only",
    "acceptedSameIncidentAction": "silent-no-model",
    "changedConditionAction": "audit-required",
    "states": [
      "active",
      "limited",
      "missing"
    ],
    "actions": [
      "noop",
      "wake",
      "audit-required"
    ],
    "requiredCapabilities": [
      "independent-trigger",
      "durable-state-read",
      "active-context-read",
      "orchestrator-work-origin-read",
      "native-wakeup",
      "fresh-context-start",
      "idempotent-incident",
      "pending-human-action-read",
      "durable-outbox-discovery"
    ],
    "triggers": [
      "project-activation",
      "task-dispatch-or-resume",
      "return-sync-written",
      "human-correction-or-detour",
      "lease-review-due",
      "milestone-or-framework-update",
      "context-compaction-or-loss",
      "orchestrator-advisory-activity",
      "active-timer"
    ]
  },
  "continuationPolicy": {
    "policy": "evidence-backed-next-action",
    "states": ["ready", "working", "waiting"],
    "activityMaxAgeSeconds": 300,
    "interruption": "resume-or-explicitly-supersede",
    "turnRelease": "productive-handoff-or-concrete-wait",
    "unknownActivity": "limited-not-stopped",
    "wakeup": "reconcile-existing-owner-never-duplicate"
  },
  "humanAttentionPolicy": {
    "policy": "durable-single-manager-attention",
    "states": [
      "none",
      "pending",
      "resurface-due"
    ],
    "requiredFields": [
      "id",
      "request",
      "source",
      "raised-at",
      "resume-after"
    ],
    "unchangedGuardAction": "silent",
    "incidentDelivery": "single-bounded-wakeup",
    "completion": "restore-or-explicitly-supersede",
    "orchestratorAvailability": "release-after-observable-dispatch"
  },
  "executionLeasePolicy": {
    "policy": "one-work-one-owning-context",
    "states": [
      "prepared",
      "started",
      "working",
      "waiting",
      "returned",
      "closed",
      "outcome-unknown"
    ],
    "requiredFields": [
      "work-id",
      "owner-and-context",
      "project-and-repository",
      "worktree-and-branch",
      "baseline-and-candidate",
      "role-and-profile",
      "dod-contribution",
      "next-receipt-or-review-by",
      "return-route"
    ]
  },
  "taskReturnPolicy": {
    "policy": "durable-outbox-native-wakeup",
    "terminalReceipt": "return-sync",
    "actionReceiptSubstitutes": false,
    "nativeWakeup": "required-attempt",
    "nativeThreadRead": "non-authoritative",
    "guardFallback": "discover-unrouted-durable-return",
    "machineFormat": "marked-return-sync-and-route-v1",
    "adapterParser": "scripts/vydykhai.mjs#validateDurableOutbox",
    "adapterAcceptance": [
      "real-emitted-return-format",
      "matching-route-receipt",
      "scheduled-noop-after-routing",
      "malformed-or-mismatched-route-audits",
      "older-pending-survives-newer-routed",
      "bounded-source-refresh-preserves-edits-and-pending",
      "pending-wakeup-survives-unrelated-change-and-recipient-handoff"
    ],
    "states": [
      "written",
      "sent",
      "received",
      "consumed",
      "routed"
    ],
    "reconcileOn": [
      "return-sync-written",
      "orchestrator-cold-path",
      "governor-check",
      "active-timer"
    ]
  },
  "rotationPolicy": {
    "policy": "independent-health-gated",
    "healthStates": [
      "healthy",
      "review",
      "repair",
      "rotate"
    ],
    "maxCompactionsWithoutIndependentCheck": 2,
    "sameClassFailureLimit": 2,
    "activeReviewHours": 24,
    "hardSignals": [
      "work-identity-mismatch",
      "dod-reconstruction-failure",
      "unconsumed-return-after-reconciliation",
      "invalid-control-state",
      "repeated-memory-application-miss",
      "ambiguous-side-effect-outcome",
      "unowned-project-work-after-repair"
    ]
  },
  "memoryPolicy": {
    "policy": "project-memory-graph",
    "graphVersion": 3,
    "anchorKinds": [
      "outcome",
      "actor",
      "entity",
      "surface",
      "contract",
      "data",
      "operation"
    ],
    "nodeTypes": [
      "invariant",
      "decision",
      "lesson",
      "idea",
      "pointer"
    ],
    "relationTypes": [
      "about",
      "requires",
      "constrains",
      "supersedes",
      "conflicts",
      "learned-from",
      "verified-by"
    ],
    "candidateActions": [
      "no-change",
      "add",
      "refine",
      "supersede",
      "retire",
      "conflict"
    ],
    "memoryMissTypes": [
      "absent",
      "retrieval-miss",
      "application-miss",
      "verification-miss"
    ],
    "protectedPointerRequiredFields": [
      "owner",
      "protected-reference",
      "environment-and-scope",
      "allowed-non-destructive-route",
      "last-safe-check",
      "expiry-or-reentry-condition"
    ],
    "recallCommitmentRequiredFields": [
      "current-meaning",
      "source",
      "capability-aliases-and-trigger",
      "applicability-timing-and-checkpoint",
      "pending-human-question"
    ],
    "taskBriefMaxNodes": null,
    "contextRoutingPolicy": "goal-to-evidence-completeness",
    "contextRoutes": ["execution", "discovery", "correction-and-acceptance"],
    "legacyInputs": [
      "intent-trail",
      "idea-memory"
    ]
  },
  "actionReceiptPolicy": {
    "policy": "critical-transition-readback",
    "boundaries": [
      "task-launch",
      "task-resume",
      "return-sync",
      "memory-reflection-and-detour",
      "protected-access",
      "acceptance-and-live-action",
      "side-effect-reconciliation"
    ],
    "boundaryOwners": {
      "task-launch": "orchestrator",
      "task-resume": "orchestrator",
      "return-sync": "orchestrator",
      "memory-reflection-and-detour": "orchestrator",
      "protected-access": "acting-context",
      "acceptance-and-live-action": "owning-task",
      "side-effect-reconciliation": "owning-task"
    },
    "fields": [
      "trigger",
      "retrieved-rule",
      "expected-action",
      "observed-action",
      "evidence",
      "result"
    ],
    "results": [
      "pass",
      "mismatch",
      "unverified",
      "outcome-unknown"
    ]
  },
  "trackerPolicy": {
    "policy": "task-contract-with-event-driven-projection",
    "statuses": [
      "todo",
      "next",
      "in-progress",
      "in-review",
      "blocked",
      "done",
      "parked"
    ]
  },
  "defaultScopeFreshnessDays": 7,
  "node": ">=18",
  "managedPaths": [
    "docs/VYDYKHAI_NOTICE.md",
    "vydykhai.json",
    "scripts/vydykhai.mjs",
    "docs/AGENTS_CORE.md",
    "docs/FRAMEWORK.md",
    "docs/FRAMEWORK_RU.md",
    "docs/COLLABORATION_FRAMEWORK_2026-06-10.md",
    "docs/COLLABORATION_FRAMEWORK_RU_2026-06-10.md",
    "docs/COLLABORATION_FRAMEWORK_CHANGELOG.md",
    "docs/workflows",
    ".agents/skills/project-launch",
    ".agents/skills/framework-orchestrator",
    ".agents/skills/start-work",
    ".agents/skills/daily-alignment",
    ".agents/skills/accept-work"
  ]
}
